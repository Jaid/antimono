{
  "name": "antimono",
  "version": "0.1.0",
  "type": "module",
  "description": "non-monospace coding font",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/antimono.git"
  },
  "exports": {
    ".": {
      "default": "./src/antimono.ts"
    }
  },
  "bin": {
    "antimono": "./src/main.ts"
  },
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "build": "bun run start && bun scripts/build.ts",
    "start": "bun src/main.ts",
    "test": "bun test --max-concurrency 1 ./test"
  },
  "dependencies": {
    "clerc": "1.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-config-jaid": "31.0.0",
    "tsconfig-jaid-bun": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4"
  }
}